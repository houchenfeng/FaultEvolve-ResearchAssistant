{
  "version": "experiment.spec/v1",
  "name": "toy-hierarchical-search",
  "routes": [
    {
      "id": "method_a",
      "default_parameters": {
        "depth": 2,
        "weight": 0.5
      },
      "parameter_domains": {
        "depth": [1, 2, 3],
        "weight": [0.25, 0.5, 0.75]
      }
    },
    {
      "id": "method_b",
      "default_parameters": {
        "alpha": 0.5
      },
      "parameter_domains": {
        "alpha": [0.25, 0.5, 0.75]
      }
    }
  ],
  "metric": {
    "key": "primary_metric",
    "direction": "maximize",
    "min_delta": 0.001,
    "target": 0.84
  },
  "budgets": {
    "max_trials": 20,
    "max_wall_seconds": 60,
    "max_parallel_trials": 2
  },
  "search": {
    "beam_width": 2,
    "exploration_slots": 1,
    "route_exploration_c": 0.35,
    "node_exploration_c": 0.35,
    "virtual_visit_penalty": 0.05,
    "duration_weight": 0.0001,
    "failure_penalty": 1.0,
    "metric_scale_floor": 1.0
  },
  "evaluation": {
    "command": [
      "python",
      "toy_evaluator.py",
      "--candidate",
      "{candidate_file}",
      "--output",
      "{result_file}"
    ],
    "evaluator_version": "toy-evaluator/v1",
    "validation_fingerprint": "toy-validation-v1",
    "repetitions": 1,
    "aggregation": "mean",
    "timeout_seconds": 10,
    "concurrency_mode": "shared-readonly/v1"
  },
  "holdout": {
    "enabled": true,
    "command": [
      "python",
      "toy_evaluator.py",
      "--candidate",
      "{candidate_file}",
      "--output",
      "{result_file}"
    ],
    "repetitions": 2,
    "aggregation": "worst",
    "timeout_seconds": 10,
    "minimum_acceptable_score": 0.82
  }
}
