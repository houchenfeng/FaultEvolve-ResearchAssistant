{
  "$defs": {
    "AblationConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_units": {
          "default": 6,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Units",
          "type": "integer"
        },
        "paired_resamples": {
          "default": 200,
          "minimum": 50,
          "title": "Paired Resamples",
          "type": "integer"
        }
      },
      "title": "AblationConfig",
      "type": "object"
    },
    "AnalysisConfig": {
      "description": "Configuration for dev-set error profiling.",
      "properties": {
        "dev_late_fraction": {
          "default": 0.4,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Dev Late Fraction",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "min_group_count": {
          "default": 10,
          "minimum": 10,
          "title": "Min Group Count",
          "type": "integer"
        },
        "on_new_best": {
          "default": true,
          "title": "On New Best",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 600,
          "exclusiveMinimum": 0,
          "maximum": 900,
          "title": "Timeout S",
          "type": "integer"
        },
        "top_k": {
          "default": 3,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        }
      },
      "title": "AnalysisConfig",
      "type": "object"
    },
    "AutotuneConfig": {
      "properties": {
        "ablation": {
          "$ref": "#/$defs/AblationConfig"
        },
        "cache": {
          "$ref": "#/$defs/CacheConfig"
        },
        "feedback": {
          "$ref": "#/$defs/FeedbackConfig"
        },
        "hpo": {
          "$ref": "#/$defs/HpoConfig"
        },
        "ledger": {
          "$ref": "#/$defs/LedgerConfig"
        },
        "patch": {
          "$ref": "#/$defs/PatchConfig"
        },
        "quota": {
          "$ref": "#/$defs/QuotaConfig"
        }
      },
      "title": "AutotuneConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "description": "Budget constraints for evolution.\n\n``max_tokens`` / ``max_wall_hours`` may be set to null to express \"no cost\nlimit\"; stopping is then governed by the experiment protocol (attempt caps,\nstall and infra rules), not by a budget. ``stage_caps`` are fractions of\n``max_tokens`` and are inert when no total token cap is set; explicit\nabsolute caps can still be given through ``stage_caps_absolute``.",
      "properties": {
        "cost_window": {
          "default": 5,
          "minimum": 1,
          "title": "Cost Window",
          "type": "integer"
        },
        "expand_gating": {
          "default": false,
          "title": "Expand Gating",
          "type": "boolean"
        },
        "max_iterations": {
          "default": 50,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 3000000,
          "title": "Max Tokens"
        },
        "max_wall_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 6.0,
          "title": "Max Wall Hours"
        },
        "min_iterations_before_stop": {
          "default": 5,
          "minimum": 0,
          "title": "Min Iterations Before Stop",
          "type": "integer"
        },
        "safety_factor": {
          "default": 1.5,
          "minimum": 1,
          "title": "Safety Factor",
          "type": "number"
        },
        "stage_caps": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Caps",
          "type": "object"
        },
        "stage_caps_absolute": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stage Caps Absolute",
          "type": "object"
        },
        "stagnation_window": {
          "default": 0,
          "minimum": 0,
          "title": "Stagnation Window",
          "type": "integer"
        },
        "stall_iterations": {
          "default": 5,
          "minimum": 1,
          "title": "Stall Iterations",
          "type": "integer"
        },
        "tokens_per_point_cap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Per Point Cap"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "CacheConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "full_eval": {
          "default": false,
          "title": "Full Eval",
          "type": "boolean"
        }
      },
      "title": "CacheConfig",
      "type": "object"
    },
    "CrossoverConfig": {
      "description": "Configuration for crossover / ensemble operator.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_code_chars": {
          "default": 6000,
          "minimum": 500,
          "title": "Max Code Chars",
          "type": "integer"
        },
        "min_valid_nodes": {
          "default": 4,
          "minimum": 2,
          "title": "Min Valid Nodes",
          "type": "integer"
        },
        "runtime_budget_s": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "title": "Runtime Budget S",
          "type": "number"
        },
        "top_quantile": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Top Quantile",
          "type": "number"
        }
      },
      "title": "CrossoverConfig",
      "type": "object"
    },
    "DataWorkflowConfig": {
      "additionalProperties": false,
      "properties": {
        "accepted_issues": {
          "items": {
            "enum": [
              "missing_feature",
              "constant_feature"
            ],
            "type": "string"
          },
          "title": "Accepted Issues",
          "type": "array"
        },
        "drop_exact_duplicates": {
          "default": true,
          "title": "Drop Exact Duplicates",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "nonfinite_to_missing": {
          "default": true,
          "title": "Nonfinite To Missing",
          "type": "boolean"
        }
      },
      "title": "DataWorkflowConfig",
      "type": "object"
    },
    "DiscoveryConfig": {
      "description": "Configuration for phenomenon-level knowledge discovery.",
      "properties": {
        "alpha": {
          "default": 0.05,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "bootstrap_b": {
          "default": 500,
          "minimum": 50,
          "title": "Bootstrap B",
          "type": "integer"
        },
        "cards_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cards Path"
        },
        "confirmation_fraction": {
          "default": 0.3,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Confirmation Fraction",
          "type": "number"
        },
        "discover_op_every": {
          "default": 0,
          "minimum": 0,
          "title": "Discover Op Every",
          "type": "integer"
        },
        "e_calibrator_kappa": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "E Calibrator Kappa",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "every_n_iterations": {
          "default": 5,
          "minimum": 1,
          "title": "Every N Iterations",
          "type": "integer"
        },
        "extra_card_paths": {
          "items": {
            "type": "string"
          },
          "title": "Extra Card Paths",
          "type": "array"
        },
        "inject_same_run": {
          "default": true,
          "title": "Inject Same Run",
          "type": "boolean"
        },
        "max_claims_per_round": {
          "default": 3,
          "minimum": 1,
          "title": "Max Claims Per Round",
          "type": "integer"
        },
        "max_neg_control_fpr": {
          "default": 0.1,
          "title": "Max Neg Control Fpr",
          "type": "number"
        },
        "max_token_share": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Token Share",
          "type": "number"
        },
        "min_insight_z": {
          "default": 2.0,
          "title": "Min Insight Z",
          "type": "number"
        },
        "neg_control_repeats": {
          "default": 5,
          "minimum": 1,
          "title": "Neg Control Repeats",
          "type": "integer"
        },
        "planted_strengths": {
          "items": {
            "type": "number"
          },
          "title": "Planted Strengths",
          "type": "array"
        },
        "rho_max": {
          "default": 0.8,
          "title": "Rho Max",
          "type": "number"
        },
        "run_at_end": {
          "default": true,
          "title": "Run At End",
          "type": "boolean"
        },
        "sandbox_timeout_s": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Sandbox Timeout S",
          "type": "integer"
        },
        "split_salt": {
          "default": "fe-kd-2026",
          "title": "Split Salt",
          "type": "string"
        },
        "top_k_programs": {
          "default": 3,
          "minimum": 0,
          "title": "Top K Programs",
          "type": "integer"
        },
        "tournament": {
          "$ref": "#/$defs/TournamentConfig"
        },
        "use_jev_entailment": {
          "default": false,
          "title": "Use Jev Entailment",
          "type": "boolean"
        }
      },
      "title": "DiscoveryConfig",
      "type": "object"
    },
    "FeedbackConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_chars": {
          "default": 2500,
          "minimum": 500,
          "title": "Max Chars",
          "type": "integer"
        }
      },
      "title": "FeedbackConfig",
      "type": "object"
    },
    "HierarchicalWorkflowConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_trials": {
          "default": 24,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Trials",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 43200,
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "mode": {
          "default": "per_structure",
          "enum": [
            "per_structure",
            "post_evolution"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "HierarchicalWorkflowConfig",
      "type": "object"
    },
    "HpoConfig": {
      "properties": {
        "dev": {
          "$ref": "#/$defs/HpoDevConfig"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "families": {
          "items": {
            "type": "string"
          },
          "title": "Families",
          "type": "array"
        },
        "max_fits_total": {
          "default": 80,
          "minimum": 1,
          "title": "Max Fits Total",
          "type": "integer"
        },
        "promote_top_k": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Promote Top K",
          "type": "integer"
        },
        "search": {
          "default": "random",
          "title": "Search",
          "type": "string"
        },
        "threads": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "trial_timeout_s": {
          "default": 300,
          "maximum": 900,
          "minimum": 10,
          "title": "Trial Timeout S",
          "type": "integer"
        },
        "trials_per_structure": {
          "default": 8,
          "maximum": 64,
          "minimum": 1,
          "title": "Trials Per Structure",
          "type": "integer"
        }
      },
      "title": "HpoConfig",
      "type": "object"
    },
    "HpoDevConfig": {
      "properties": {
        "dev_late_fraction": {
          "default": 0.4,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Dev Late Fraction",
          "type": "number"
        },
        "min_dev_pos": {
          "default": 20,
          "minimum": 1,
          "title": "Min Dev Pos",
          "type": "integer"
        },
        "min_train_pos": {
          "default": 20,
          "minimum": 1,
          "title": "Min Train Pos",
          "type": "integer"
        },
        "purge_days": {
          "default": 7,
          "minimum": 0,
          "title": "Purge Days",
          "type": "integer"
        }
      },
      "title": "HpoDevConfig",
      "type": "object"
    },
    "InsightsConfig": {
      "description": "Configuration for insight propagation.",
      "properties": {
        "reputation_enabled": {
          "default": false,
          "title": "Reputation Enabled",
          "type": "boolean"
        },
        "summarize_every": {
          "default": 5,
          "title": "Summarize Every",
          "type": "integer"
        },
        "top_k_branch_memory": {
          "default": 5,
          "title": "Top K Branch Memory",
          "type": "integer"
        },
        "top_k_foreign": {
          "default": 3,
          "title": "Top K Foreign",
          "type": "integer"
        },
        "top_k_negative": {
          "default": 3,
          "title": "Top K Negative",
          "type": "integer"
        }
      },
      "title": "InsightsConfig",
      "type": "object"
    },
    "IslandSpec": {
      "description": "One island: an independent search tree with its own strategy focus.\n\n``profile`` is a soft strategy bias, not a hard restriction: every island\ncan still use any enabled operator. ``exploration_ratio`` reserves part of\noperator choices for strategies outside the island's own focus.\n\nThe exact empty ``island_id`` is reserved for the implicit single island of\na pre-island run, whose ``node`` rows carry no label; the engine builds that\nspec itself. Configured islands have to be named -- see\n``IslandsConfig._validate_islands``.",
      "properties": {
        "exploration_ratio": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Exploration Ratio",
          "type": "number"
        },
        "focus": {
          "default": "",
          "title": "Focus",
          "type": "string"
        },
        "island_id": {
          "title": "Island Id",
          "type": "string"
        },
        "knowledge_keywords": {
          "items": {
            "type": "string"
          },
          "title": "Knowledge Keywords",
          "type": "array"
        },
        "max_attempts": {
          "default": 50,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "operator_bias": {
          "items": {
            "type": "string"
          },
          "title": "Operator Bias",
          "type": "array"
        },
        "profile": {
          "default": "performance",
          "pattern": "^(performance|miss_alert|efficiency|custom)$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "island_id"
      ],
      "title": "IslandSpec",
      "type": "object"
    },
    "IslandsConfig": {
      "description": "Three-island orchestration settings.\n\n``enabled=False`` (or a single explicit island) keeps the legacy one-tree\nbehavior; restored historical runs are always resolved to a single island\nby the engine, never silently upgraded to three.",
      "properties": {
        "early_error_share": {
          "default": true,
          "title": "Early Error Share",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "eval_concurrency": {
          "default": 1,
          "minimum": 1,
          "title": "Eval Concurrency",
          "type": "integer"
        },
        "exchange_interval": {
          "default": 5,
          "minimum": 1,
          "title": "Exchange Interval",
          "type": "integer"
        },
        "infra_fail_pause": {
          "default": 5,
          "minimum": 1,
          "title": "Infra Fail Pause",
          "type": "integer"
        },
        "islands": {
          "items": {
            "$ref": "#/$defs/IslandSpec"
          },
          "title": "Islands",
          "type": "array"
        },
        "max_negative_per_exchange": {
          "default": 2,
          "minimum": 0,
          "title": "Max Negative Per Exchange",
          "type": "integer"
        },
        "max_positive_per_exchange": {
          "default": 1,
          "minimum": 0,
          "title": "Max Positive Per Exchange",
          "type": "integer"
        },
        "max_summaries_in_context": {
          "default": 3,
          "minimum": 0,
          "title": "Max Summaries In Context",
          "type": "integer"
        },
        "min_valid_evals_before_stall": {
          "default": 10,
          "minimum": 0,
          "title": "Min Valid Evals Before Stall",
          "type": "integer"
        },
        "stagnation_request_evals": {
          "default": 10,
          "minimum": 1,
          "title": "Stagnation Request Evals",
          "type": "integer"
        },
        "stall_valid_evals": {
          "default": 15,
          "minimum": 1,
          "title": "Stall Valid Evals",
          "type": "integer"
        }
      },
      "title": "IslandsConfig",
      "type": "object"
    },
    "JudgeConfig": {
      "description": "Configuration for the fast structured judge.",
      "properties": {
        "api_key_env": {
          "default": "MIYANG_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "audit_rate": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Audit Rate",
          "type": "number"
        },
        "base_url": {
          "default": "https://miyang.cn/api/v1/decisions",
          "title": "Base Url",
          "type": "string"
        },
        "calibration_window": {
          "default": 30,
          "minimum": 0,
          "title": "Calibration Window",
          "type": "integer"
        },
        "defer_flush_evals": {
          "default": 0,
          "minimum": 0,
          "title": "Defer Flush Evals",
          "type": "integer"
        },
        "initial_trust": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Initial Trust",
          "type": "number"
        },
        "invalid_threshold": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Invalid Threshold",
          "type": "number"
        },
        "low_value_action": {
          "default": "skip",
          "pattern": "^(skip|defer)$",
          "title": "Low Value Action",
          "type": "string"
        },
        "low_value_threshold": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Low Value Threshold",
          "type": "number"
        },
        "max_calls": {
          "default": 500,
          "minimum": 0,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_consecutive_errors": {
          "default": 3,
          "minimum": 1,
          "title": "Max Consecutive Errors",
          "type": "integer"
        },
        "max_state_chars": {
          "default": 6000,
          "minimum": 1,
          "title": "Max State Chars",
          "type": "integer"
        },
        "model": {
          "default": "miyang/jev-1.13",
          "title": "Model",
          "type": "string"
        },
        "prescreen": {
          "default": false,
          "title": "Prescreen",
          "type": "boolean"
        },
        "prior": {
          "default": true,
          "title": "Prior",
          "type": "boolean"
        },
        "prior_tau": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Prior Tau",
          "type": "number"
        },
        "provider": {
          "default": "none",
          "pattern": "^(none|jev|mock)$",
          "title": "Provider",
          "type": "string"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timeout_s": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        },
        "warmup": {
          "default": 10,
          "minimum": 0,
          "title": "Warmup",
          "type": "integer"
        }
      },
      "title": "JudgeConfig",
      "type": "object"
    },
    "KnowledgeConfig": {
      "description": "Configuration for knowledge injection.",
      "properties": {
        "dir": {
          "default": "",
          "title": "Dir",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "k": {
          "default": 4,
          "title": "K",
          "type": "integer"
        },
        "max_per_category": {
          "default": 2,
          "title": "Max Per Category",
          "type": "integer"
        }
      },
      "title": "KnowledgeConfig",
      "type": "object"
    },
    "LLMConfig": {
      "description": "Configuration for LLM calls.",
      "properties": {
        "base_url": {
          "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "title": "Base Url",
          "type": "string"
        },
        "generate_model": {
          "default": "qwen3-coder-plus",
          "title": "Generate Model",
          "type": "string"
        },
        "max_concurrency": {
          "default": 4,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_tokens": {
          "default": 8000,
          "title": "Max Tokens",
          "type": "integer"
        },
        "reason_model": {
          "default": "qwen3-max",
          "title": "Reason Model",
          "type": "string"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "temperature": {
          "default": 0.7,
          "title": "Temperature",
          "type": "number"
        },
        "timeout_s": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "LLMConfig",
      "type": "object"
    },
    "LedgerConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "full_eval_cap": {
          "anyOf": [
            {
              "minimum": 1,
