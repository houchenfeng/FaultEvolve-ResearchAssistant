# Copy this file to .env. Never commit real credentials.
DASHSCOPE_API_KEY=your_qwen_api_key
MIYANG_API_KEY=

# Optional: store run metadata on a local disk and larger artifacts separately.
FE_RUNS_DIR=./.fe/runs
FE_ARTIFACTS_DIR=./.fe/artifacts

# Hybrid mode: remote self-evolution over SSH (scripts/edge_remote_evolver.py).
# FE_LLM_PROVIDER: qwen (DashScope key above) or codex (local `codex login`).
FE_LLM_PROVIDER=qwen
FE_QWEN_MODEL=qwen3.8-max-0902
FE_SSH_JUMP=user@jump.example:22
FE_SSH_JUMP_PASSWORD=
FE_SSH_TARGET=user@127.0.0.1:22
FE_SSH_TARGET_PASSWORD=
FE_REMOTE_ROOT=/path/on/server/edge_hybrid
FE_REMOTE_PYTHON=/path/on/server/python

# Optional only when using the distributed worker mode.
FE_SERVER_URL=https://your_server.example:8443
FE_API_KEY=your_shared_worker_secret
